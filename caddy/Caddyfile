# Caddy: single domain, single login. Our auth-service owns identity; Caddy
# gates every protected route with forward_auth against it, then routes to the
# right backend. Nothing but Caddy is reachable from outside.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# ---- public routes (reachable while logged out) ----------------------
	# The login page and the auth API must work before a session exists.
	@public path /login /api/auth/*
	handle @public {
		reverse_proxy auth-service:8080
	}

	# ---- everything else is gated ---------------------------------------
	handle {
		# `route` runs directives in written order: authenticate FIRST, then
		# proxy to whichever backend matches.
		route {
			forward_auth auth-service:8080 {
				uri /api/auth/verify
				copy_headers X-Auth-User X-Auth-User-Id X-Auth-Is-Admin
				@denied status 401 403
				handle_response @denied {
					redir * /login?next={uri}
				}
			}

			# admin panel + admin API -> auth-service
			@admin path /admin /admin/* /api/admin/*
			reverse_proxy @admin auth-service:8080

			# file manager (UI + API) -> file-manager
			@files path /files /files/* /api/files/*
			reverse_proxy @files file-manager:8080

			# default: chat workbench (claudecodeui, incl. WebSocket /ws)
			reverse_proxy agent:3001
		}
	}
}
