# ============================================================================
#  video-edit-ai — environment template
#  Copy to .env and fill in.  NEVER commit the real .env.
#
#  Trust model (read before editing):
#   - REAL provider keys (Anthropic / TOS / Doubao / Ark) live ONLY in the
#     host-side services: litellm and media-gateway.
#   - The agent container gets ONLY gateway tokens (LITELLM_MASTER_KEY,
#     MEDIA_GATEWAY_TOKEN). Anyone running `env` inside the agent must not be
#     able to reach a provider directly.  See docker-compose.yml networks.
# ============================================================================

# ----- Public entrypoint (Caddy) --------------------------------------------
# Single domain. Everything (login, admin, files, chat) is served under it.
DOMAIN=example.com
# Email for Let's Encrypt / ZeroSSL ACME.
ACME_EMAIL=you@example.com

# ----- Auth service (accounts / login / admin) ------------------------------
# HMAC secret for session cookies. Generate: openssl rand -hex 32
AUTH_JWT_SECRET=REPLACE_ME
# Seed admin, created once on first boot. Change the password after first login
# via the /admin panel is not yet supported — set a strong one here.
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASSWORD=REPLACE_ME
# Set true in production (HTTPS). Keep false only for plain-http local testing.
AUTH_COOKIE_SECURE=true

# ----- LiteLLM (LLM gateway, holds the REAL Anthropic key) ------------------
# Pinned, cosign-signed image tag. Do NOT use 1.82.7 / 1.82.8 (supply-chain
# backdoor, March 2026). See litellm/config.yaml header.
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-v1.83.14-stable
# master_key doubles as the agent's bearer token in MVP (no DB).
# Generate: openssl rand -hex 24  (must start with sk-)
LITELLM_MASTER_KEY=sk-REPLACE_ME
# Upstream credential. For production put your real Anthropic key here.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# --- OR --- temporary dev gateway (OpenAI-compatible). Leave Anthropic blank
# and uncomment these to route through the shared test gateway instead.
# DEV_OPENAI_BASE_URL=https://test.sheepwall.com/fe-llm-gateway
# DEV_OPENAI_API_KEY=sk-REPLACE_ME
# DEV_OPENAI_MODEL=deepseek-v4-pro

# ----- Agent container (Claude Code UI) — gateway tokens ONLY ----------------
# What the agent actually sees. ANTHROPIC_BASE_URL points at LiteLLM (in-net).
ANTHROPIC_MODEL=claude-sonnet-5
# claudecodeui workspace root (project tree = the TOS mount).
WORKSPACES_ROOT=/workspace

# ----- media-gateway (holds REAL TOS / Doubao / Ark keys) -------------------
# Bearer token the agent uses to call media-gateway. openssl rand -hex 24
MEDIA_GATEWAY_TOKEN=REPLACE_ME

# Volcengine TOS (S3-compatible). Use a SUB-ACCOUNT AK/SK whose bucket policy
# is limited to TOS_PREFIX only. Do NOT grant TOSFullAccess.
TOS_REGION=cn-beijing
TOS_ENDPOINT=https://tos-s3-cn-beijing.volces.com
TOS_BUCKET=your-bucket
# Everything the platform touches lives under this key prefix.
TOS_PREFIX=video-edit/
TOS_ACCESS_KEY=REPLACE_ME
TOS_SECRET_KEY=REPLACE_ME

# Doubao 录音文件识别大模型 (v3) — new voice console. v3 uses APP ID + Access Token:
#   DOUBAO_ASR_APP_KEY   = APP ID (e.g. 4430394030)
#   DOUBAO_ASR_ACCESS_KEY = Access Token
# The product must be ACTIVATED (开通 录音文件识别大模型) or you get "resource not granted".
DOUBAO_ASR_BASE_URL=https://openspeech.bytedance.com
DOUBAO_ASR_APP_KEY=REPLACE_ME
DOUBAO_ASR_ACCESS_KEY=REPLACE_ME
# Whichever resource id your activated product uses: volc.bigasr.auc or volc.seedasr.auc
DOUBAO_ASR_RESOURCE=volc.bigasr.auc

# Volcengine Ark (方舟) — OpenAI-compatible VLM for batch coarse scanning.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=REPLACE_ME
# Model endpoint id (ep-...) or model name of a vision-capable model.
ARK_VLM_MODEL=REPLACE_ME
